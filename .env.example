
# Backend
PORT=3001
NODE_ENV=development

# AI Service
AI_SERVICE_URL=http://127.0.0.1:8000

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/knowflow

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d

# Storage
STORAGE_MODE=local
STORAGE_PATH=./storage/uploads
